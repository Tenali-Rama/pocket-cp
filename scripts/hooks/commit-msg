#!/usr/bin/env bash
# Git commit-msg hook: commits are authored by the owner only, with no AI attribution lines.
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/factory/owner.env"
email=$(git var GIT_AUTHOR_IDENT | sed -E 's/.*<([^>]*)>.*/\1/')
if [ "$email" != "$OWNER_EMAIL" ]; then
  echo "commit-msg: author must be <$OWNER_EMAIL>, got <$email>" >&2
  exit 1
fi
clean=$(grep -viE 'co-authored-by:.*(claude|anthropic)|generated with \[?claude' "$1" || true)
printf '%s\n' "$clean" >"$1"
